// UploadAutomationManager.NEW.js - Complete rewrite for image paste automation
// Handles: Multi-file selection → Queue → Clipboard copy → Paste → Navigation → Loop

window.UploadAutomationManager = class UploadAutomationManager {
    constructor(stateManager) {
        this.stateManager = stateManager;
        this._enabled = false;
        
        // Queue management
        this._queue = [];
        this._activeItem = null;
        this._failedItems = [];
        this._processedCount = 0;
        
        // State tracking
        this._isProcessing = false;
        this._currentImageId = null;
        this._waitingForGeneration = false;
        
        // Selectors
        this.TEXTAREA_SELECTORS = [
            'div[contenteditable="true"][data-placeholder="Type to imagine"]',
            'div[contenteditable="true"][data-placeholder*="imagine"]',
            'div[contenteditable="true"][role="textbox"]',
            'div.tiptap.ProseMirror[contenteditable="true"]',
            'textarea[placeholder*="imagine"]'
        ];
        
        this.GALLERY_PATHS = ['/imagine/favorites', '/imagine'];
        
        // Bind handlers
        this._boundModeChange = this._handleModeChange.bind(this);
        this._boundPathChange = this._handlePathChange.bind(this);
        this._boundNewRequest = this._handleNewRequest.bind(this);
        
        // Listen for mode changes
        window.addEventListener('gvp:upload-mode-changed', this._boundModeChange);
        
        console.log('[GVP Upload] UploadAutomationManager initialized');
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // PUBLIC API
    // ═══════════════════════════════════════════════════════════════════
    
    start() {
        if (this._enabled) return;
        
        this._enabled = this.stateManager?.isUploadAutomationEnabled?.() ?? false;
        
        if (!this._enabled) {
            console.log('[GVP Upload] Not starting - mode disabled');
            return;
        }
        
        console.log('[GVP Upload] 🚀 Starting upload automation');
        this._installPathObserver();
        this._installNetworkObserver();
        
        // If we have queued items, start processing
        if (this._queue.length > 0 && !this._isProcessing) {
            this._processQueue('start');
        }
    }
    
    destroy() {
        console.log('[GVP Upload] Destroying upload automation');
        this._enabled = false;
        this._isProcessing = false;
        this._queue = [];
        this._activeItem = null;
        this._currentImageId = null;
        this._waitingForGeneration = false;
        
        window.removeEventListener('gvp:upload-mode-changed', this._boundModeChange);
    }
    
    isEnabled() {
        return this._enabled;
    }
    
    /**
     * Add files to the queue
     * @param {FileList|File[]} files - Files to process
     */
    enqueueFiles(files) {
        if (!this._enabled) {
            console.warn('[GVP Upload] Cannot enqueue - mode disabled');
            return 0;
        }
        
        const fileArray = files instanceof FileList ? Array.from(files) : files;
        const validFiles = fileArray.filter(file => 
            file instanceof File && file.type.startsWith('image/')
        );
        
        if (validFiles.length === 0) {
            console.warn('[GVP Upload] No valid image files to enqueue');
            return 0;
        }
        
        // Add to queue with metadata
        validFiles.forEach(file => {
            this._queue.push({
                id: crypto.randomUUID(),
                file: file,
                name: file.name,
                size: file.size,
                type: file.type,
                queuedAt: Date.now(),
                attempts: 0,
                status: 'pending'
            });
        });
        
        console.log('[GVP Upload] ✅ Queued files:', {
            added: validFiles.length,
            total: this._queue.length,
            names: validFiles.map(f => f.name)
        });
        
        // Start processing if not already running
        if (!this._isProcessing) {
            this._processQueue('enqueue');
        }
        
        return validFiles.length;
    }
    
    /**
     * Get current queue status
     */
    getStatus() {
        return {
            enabled: this._enabled,
            processing: this._isProcessing,
            queueLength: this._queue.length,
            activeItem: this._activeItem ? this._activeItem.name : null,
            processed: this._processedCount,
            failed: this._failedItems.length
        };
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // QUEUE PROCESSING
    // ═══════════════════════════════════════════════════════════════════
    
    async _processQueue(trigger = 'unknown') {
        if (!this._enabled) {
            console.log('[GVP Upload] Processing stopped - mode disabled');
            return;
        }
        
        if (this._isProcessing) {
            console.log('[GVP Upload] Already processing queue');
            return;
        }
        
        if (this._queue.length === 0) {
            console.log('[GVP Upload] ✅ Queue empty - all files processed');
            this._isProcessing = false;
            this._activeItem = null;
            return;
        }
        
        // Ensure we're on the gallery page
        if (!this._isOnGalleryPage()) {
            console.log('[GVP Upload] Not on gallery page, navigating back...');
            await this._navigateToGallery();
            
            // Wait for page to settle
            await this._delay(500);
            
            if (!this._isOnGalleryPage()) {
                console.error('[GVP Upload] Failed to navigate to gallery page');
                // Retry after delay
                setTimeout(() => this._processQueue('gallery-retry'), 2000);
                return;
            }
        }
        
        // Get next item
        const item = this._queue.shift();
        this._activeItem = item;
        this._isProcessing = true;
        item.attempts += 1;
        item.status = 'processing';
        
        console.log('[GVP Upload] 📤 Processing image:', {
            name: item.name,
            attempt: item.attempts,
            remaining: this._queue.length,
            trigger
        });
        
        try {
            // Step 1: Copy image to clipboard
            await this._copyImageToClipboard(item.file);
            
            // Step 2: Find textarea
            const textarea = await this._findTextarea();
            if (!textarea) {
                throw new Error('Textarea not found');
            }
            
            // Step 3: Paste image into textarea
            await this._pasteIntoTextarea(textarea);
            
            // Step 4: Wait for navigation to post page
            const imageId = await this._waitForPostPage();
            
            if (!imageId) {
                throw new Error('Failed to navigate to post page');
            }
            
            this._currentImageId = imageId;
            console.log('[GVP Upload] 📍 Navigated to post page:', imageId);
            
            // Step 5: Wait for /new request (generation started)
            this._waitingForGeneration = true;
            await this._waitForGenerationStart();
            
            console.log('[GVP Upload] ✅ Generation started for:', item.name);
            
            // Step 6: Navigate back to gallery
            await this._navigateToGallery();
            
            // Mark as completed
            item.status = 'completed';
            this._processedCount += 1;
            
            console.log('[GVP Upload] ✅ Completed:', {
                name: item.name,
                imageId: imageId,
                processed: this._processedCount,
                remaining: this._queue.length
            });
            
            // Clean up
            this._activeItem = null;
            this._currentImageId = null;
            this._waitingForGeneration = false;
            this._isProcessing = false;
            
            // Small delay before next item
            await this._delay(500);
            
            // Process next item
            this._processQueue('completed');
            
        } catch (error) {
            console.error('[GVP Upload] ❌ Failed to process image:', error);
            
            // Retry logic
            if (item.attempts < 3) {
                console.log('[GVP Upload] Retrying:', item.name, `(attempt ${item.attempts + 1}/3)`);
                this._queue.unshift(item); // Put back at front
            } else {
                console.error('[GVP Upload] Max retries reached for:', item.name);
                item.status = 'failed';
                item.error = error.message;
                this._failedItems.push(item);
            }
            
            // Clean up
            this._activeItem = null;
            this._currentImageId = null;
            this._waitingForGeneration = false;
            this._isProcessing = false;
            
            // Try next item after delay
            await this._delay(1000);
            this._processQueue('error-retry');
        }
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // CLIPBOARD & PASTE OPERATIONS
    // ═══════════════════════════════════════════════════════════════════
    
    async _copyImageToClipboard(file) {
        console.log('[GVP Upload] 📋 Copying to clipboard:', file.name);
        
        try {
            // Create ClipboardItem with the image
            const clipboardItem = new ClipboardItem({
                [file.type]: file
            });
            
            await navigator.clipboard.write([clipboardItem]);
            console.log('[GVP Upload] ✅ Copied to clipboard');
            
        } catch (error) {
            console.error('[GVP Upload] Clipboard API failed, trying fallback:', error);
            
            // Fallback: Create blob URL and try alternative method
            throw new Error('Clipboard copy failed: ' + error.message);
        }
    }
    
    async _pasteIntoTextarea(textarea) {
        console.log('[GVP Upload] 📝 Pasting into textarea');
        
        try {
            // Focus the textarea
            if (textarea.focus) {
                textarea.focus();
            }
            
            // Small delay to ensure focus
            await this._delay(100);
            
            // Read from clipboard
            const clipboardItems = await navigator.clipboard.read();
            
            if (clipboardItems.length === 0) {
                throw new Error('Clipboard is empty');
            }
            
            // Get the image blob
            const clipboardItem = clipboardItems[0];
            const imageTypes = clipboardItem.types.filter(type => type.startsWith('image/'));
            
            if (imageTypes.length === 0) {
                throw new Error('No image in clipboard');
            }
            
            const imageType = imageTypes[0];
            const blob = await clipboardItem.getType(imageType);
            
            // Create DataTransfer with the blob
            const dataTransfer = new DataTransfer();
            const file = new File([blob], 'paste.png', { type: imageType });
            dataTransfer.items.add(file);
            
            // Create and dispatch paste event
            const pasteEvent = new ClipboardEvent('paste', {
                bubbles: true,
                cancelable: true,
                clipboardData: dataTransfer
            });
            
            textarea.dispatchEvent(pasteEvent);
            
            console.log('[GVP Upload] ✅ Paste event dispatched');
            
        } catch (error) {
            console.error('[GVP Upload] Paste failed:', error);
            throw new Error('Paste failed: ' + error.message);
        }
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // NAVIGATION & PATH MONITORING
    // ═══════════════════════════════════════════════════════════════════
    
    _installPathObserver() {
        if (this._pathObserverInstalled) return;
        
        // Watch for path changes using MutationObserver and interval fallback
        let lastPath = window.location.pathname;
        
        this._pathCheckInterval = setInterval(() => {
            const currentPath = window.location.pathname;
            if (currentPath !== lastPath) {
                lastPath = currentPath;
                this._boundPathChange(currentPath);
            }
        }, 200);
        
        // Also listen for popstate events
        window.addEventListener('popstate', () => {
            this._boundPathChange(window.location.pathname);
        });
        
        this._pathObserverInstalled = true;
        console.log('[GVP Upload] Path observer installed');
    }
    
    _handlePathChange(path) {
        console.log('[GVP Upload] 🔀 Path changed:', path);
        
        // Check if we're waiting for post page
        if (this._isProcessing && !this._waitingForGeneration) {
            const imageId = this._extractImageIdFromPath(path);
            if (imageId && this._postPageResolver) {
                this._postPageResolver(imageId);
                this._postPageResolver = null;
            }
        }
    }
    
    _isOnGalleryPage() {
        const path = window.location.pathname;
        return this.GALLERY_PATHS.some(galleryPath => path.startsWith(galleryPath));
    }
    
    _extractImageIdFromPath(path) {
        // Extract from /imagine/post/{imageId}
        const match = path.match(/\/imagine\/post\/([a-f0-9\-]+)/i);
        return match ? match[1] : null;
    }
    
    async _waitForPostPage(timeout = 10000) {
        console.log('[GVP Upload] ⏳ Waiting for post page...');
        
        return new Promise((resolve, reject) => {
            // Check if already on post page
            const currentImageId = this._extractImageIdFromPath(window.location.pathname);
            if (currentImageId) {
                console.log('[GVP Upload] Already on post page:', currentImageId);
                resolve(currentImageId);
                return;
            }
            
            // Set up resolver
            this._postPageResolver = resolve;
            
            // Timeout
            setTimeout(() => {
                if (this._postPageResolver === resolve) {
                    this._postPageResolver = null;
                    reject(new Error('Timeout waiting for post page'));
                }
            }, timeout);
        });
    }
    
    async _navigateToGallery() {
        console.log('[GVP Upload] 🏠 Navigating to gallery...');
        
        const currentPath = window.location.pathname;
        
        // Already on gallery?
        if (this._isOnGalleryPage()) {
            console.log('[GVP Upload] Already on gallery page');
            return;
        }
        
        // Try ESC key first (most reliable for Grok)
        await this._sendEscapeKey();
        await this._delay(300);
        
        if (this._isOnGalleryPage()) {
            console.log('[GVP Upload] ✅ ESC key worked');
            return;
        }
        
        // Try back button click
        const backButton = document.querySelector('[data-testid="modal-close-button"], button[aria-label="Close"], button[aria-label="Back"]');
        if (backButton) {
            backButton.click();
            await this._delay(300);
            
            if (this._isOnGalleryPage()) {
                console.log('[GVP Upload] ✅ Back button worked');
                return;
            }
        }
        
        // Try history.back()
        if (window.history.length > 1) {
            window.history.back();
            await this._delay(300);
            
            if (this._isOnGalleryPage()) {
                console.log('[GVP Upload] ✅ history.back() worked');
                return;
            }
        }
        
        // Last resort: Direct navigation using SPA routing
        const galleryPath = '/imagine/favorites';
        console.log('[GVP Upload] Using direct SPA navigation to:', galleryPath);
        
        window.history.pushState({}, '', galleryPath);
        window.dispatchEvent(new PopStateEvent('popstate'));
        
        await this._delay(500);
    }
    
    async _sendEscapeKey() {
        const escEvent = new KeyboardEvent('keydown', {
            key: 'Escape',
            code: 'Escape',
            keyCode: 27,
            which: 27,
            bubbles: true,
            cancelable: true
        });
        document.dispatchEvent(escEvent);
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // NETWORK MONITORING
    // ═══════════════════════════════════════════════════════════════════
    
    _installNetworkObserver() {
        if (this._networkObserverInstalled) return;
        
        // This will be called by NetworkInterceptor when /new is detected
        // Set up a global handler
        window.addEventListener('gvp:generation-new-detected', this._boundNewRequest);
        
        this._networkObserverInstalled = true;
        console.log('[GVP Upload] Network observer installed');
    }
    
    _handleNewRequest(event) {
        if (!this._waitingForGeneration) return;
        
        const { imageId, requestId } = event.detail || {};
        
        console.log('[GVP Upload] 🎬 /new request detected:', { imageId, requestId });
        
        // Resolve the generation wait promise
        if (this._generationResolver) {
            this._generationResolver();
            this._generationResolver = null;
        }
    }
    
    async _waitForGenerationStart(timeout = 15000) {
        console.log('[GVP Upload] ⏳ Waiting for generation to start...');
        
        return new Promise((resolve, reject) => {
            this._generationResolver = resolve;
            
            // Timeout
            setTimeout(() => {
                if (this._generationResolver === resolve) {
                    this._generationResolver = null;
                    reject(new Error('Timeout waiting for generation start'));
                }
            }, timeout);
        });
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // UTILITY METHODS
    // ═══════════════════════════════════════════════════════════════════
    
    async _findTextarea(timeout = 5000) {
        console.log('[GVP Upload] 🔍 Finding textarea...');
        
        const startTime = Date.now();
        
        while (Date.now() - startTime < timeout) {
            for (const selector of this.TEXTAREA_SELECTORS) {
                const element = document.querySelector(selector);
                if (element) {
                    console.log('[GVP Upload] ✅ Found textarea:', selector);
                    return element;
                }
            }
            
            await this._delay(200);
        }
        
        console.error('[GVP Upload] ❌ Textarea not found after', timeout, 'ms');
        return null;
    }
    
    _handleModeChange(event) {
        const enabled = event?.detail?.enabled ?? false;
        console.log('[GVP Upload] Mode changed:', enabled);
        
        if (enabled && !this._enabled) {
            this._enabled = true;
            this.start();
        } else if (!enabled && this._enabled) {
            this._enabled = false;
            this.destroy();
        }
    }
    
    _delay(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // EXTERNAL INTEGRATION POINTS
    // ═══════════════════════════════════════════════════════════════════
    
    /**
     * Called by NetworkInterceptor when generation is detected
     * @deprecated Use event listener instead
     */
    notifyGenerationStarted(meta) {
        // Dispatch event for consistency
        window.dispatchEvent(new CustomEvent('gvp:generation-new-detected', {
            detail: meta
        }));
    }
    
    /**
     * Called by NetworkInterceptor on success
     * Not needed for this workflow but kept for compatibility
     */
    handleGenerationSuccess(meta) {
        console.log('[GVP Upload] Generation success:', meta);
    }
    
    /**
     * Called by NetworkInterceptor on failure
     * Not needed for this workflow but kept for compatibility
     */
    notifyUploadFailure(meta) {
        console.warn('[GVP Upload] Upload failure:', meta);
    }
};
