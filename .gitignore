# GVP Repository - Strict Whitelist
# Ignores everything by default, whitelists only extension core.
# .agent/, session backups, KI tooling, and all local data are excluded by default via *.

# 1. Ignore everything
*
.*

# 2. Allow Git and repo meta
!.gitignore
!README.md

# 3. Allow extension core only
!manifest.json
!src/
!src/**/
!src/**
!public/
!public/**/
!public/**
!icons/
!icons/**/
!icons/**
!_locales/
!_locales/**/
!_locales/**

# 4. Safety exclusions within allowed folders
src/**/*.json
src/**/*.html
public/**/*.json
public/**/*.html

# 5. Explicit icon folder data file exclusions
# Add a '!' prefix before a file to re-allow an ignored pattern after verification
icons/*.json
icons/*.txt